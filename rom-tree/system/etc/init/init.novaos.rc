# ============================================================================
# NovaOS Kernel & System Initialization Script (init.novaos.rc)
# Executed by Android init daemon at boot_completed on Xiaomi 8
# ============================================================================

on post-fs-data
    # Kích hoạt SUSFS v1.5 Kernel-Level Stealth (Ẩn dấu vết Root & Mount Points)
    write /sys/kernel/susfs/enable_stealth 1
    write /sys/kernel/susfs/hide_sus_mounts 1
    write /sys/kernel/susfs/spoof_bootloader_locked 1

on property:sys.boot_completed=1
    # 1. Tối ưu ZRAM & Quản lý bộ nhớ cho Xiaomi 8 (4GB / 6GB RAM)
    write /proc/sys/vm/swappiness 60
    write /proc/sys/vm/vfs_cache_pressure 80
    write /proc/sys/vm/dirty_ratio 15
    write /proc/sys/vm/dirty_background_ratio 5

    # 2. Tối ưu bộ điều phối CPU Snapdragon (schedutil) để mát máy & tiết kiệm pin đêm
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor "schedutil"

    # 3. Miễn trừ ngủ đông (Doze Whitelist) cho Zalo, Messenger & Ngân hàng VN
    exec - system system -- /system/bin/cmd deviceidle whitelist +com.zing.zalo
    exec - system system -- /system/bin/cmd deviceidle whitelist +com.facebook.orca
    exec - system system -- /system/bin/cmd deviceidle whitelist +com.mbmobile
    exec - system system -- /system/bin/cmd deviceidle whitelist +com.VCB
    exec - system system -- /system/bin/cmd deviceidle whitelist +com.vn.id

    # 4. Thiết lập DNS tốc độ cao Cloudflare 1.1.1.1 cho 4G & Wi-Fi
    setprop net.dns1 1.1.1.1
    setprop net.dns2 1.0.0.1

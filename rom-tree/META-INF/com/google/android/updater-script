# 1. CHỐT CHẶN AN TOÀN: Kiểm tra đúng mã phần cứng Xiaomi 8 mới cho phép nạp
assert(
    getprop("ro.product.device") == "dipper" || getprop("ro.build.product") == "dipper" ||
    getprop("ro.product.device") == "ginkgo" || getprop("ro.build.product") == "ginkgo" ||
    getprop("ro.product.device") == "olive"  || getprop("ro.build.product") == "olive"  ||
    abort("LỖI AN TOÀN: Bản ROM này chỉ dành cho Xiaomi 8 (dipper/ginkgo/olive). Đã dừng để bảo vệ máy!");
);

ui_print("[1/5] Đang kiểm tra phân vùng động (Retrofit Dynamic Partitions)...");
show_progress(0.200000, 10);

ui_print("[2/5] Đang nạp phân vùng Hệ Điều Hành mới (system.img)...");
package_extract_file("system.img", "/dev/block/bootdevice/by-name/system");
show_progress(0.500000, 40);

ui_print("[3/5] Đang gắn cấu hình Chuẩn Việt Nam (4G VoLTE, Fix Zalo, SUSFS)...");
mount("ext4", "EMMC", "/dev/block/bootdevice/by-name/system", "/system");
package_extract_dir("system", "/system");
set_perm_recursive(0, 0, 0755, 0644, "/system/etc/init");
unmount("/system");
show_progress(0.200000, 10);

ui_print("[4/5] Đang nạp nhân Kernel eBPF + KernelSU-Next + SUSFS (boot.img)...");
package_extract_file("boot.img", "/dev/block/bootdevice/by-name/boot");
show_progress(0.100000, 5);

ui_print("[5/5] Hoàn tất! Hệ điều hành NovaOS đã sẵn sàng khởi động.");
ui_print("====================================================");
